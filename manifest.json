{
  "manifest_version": 3,
  "name": "Internet Pulse",
  "version": "1.0.0",
  "description": "Ad-free live view of Downdetector's most-reported list, official status-page incidents, and security headlines.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Internet Pulse",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://downdetector.com/*",
    "https://downdetector.co.uk/*",
    "https://downdetector.ca/*",
    "https://somesystemsoperational.com/*",
    "https://www.bleepingcomputer.com/*",
    "https://therecord.media/*"
  ]
}
